    "goal": "Analyze today's failed payments, recover eligible revenue while respecting company recovery policies, handle unsuccessful recovery attempts safely, and produce an auditable recovery report.",
    "steps": [
      {
        "step_id": "step_1",
        "objective": "Retrieve and aggregate evidence for all payments that failed today",
        "rationale": "Collecting payment ID, amount, status, method, failure reason, attempt count, and prior recovery attempts provides the data foundation for analysis and policy compliance.",
        "status": "completed"
      },
      {
        "step_id": "step_2",
        "objective": "Analyze each failed payment to determine eligibility for automatic recovery",
        "rationale": "Evaluation of amount, failure reason, and prior attempts identifies which payments meet the deterministic policy thresholds for automatic actions.",
        "status": "completed"
      },
      {
        "step_id": "step_3",
        "objective": "Validate proposed automatic recovery actions against deterministic policies",
        "rationale": "Ensures that the selected action (retry, request_alternate_payment, or notify_and_retry_later) complies with maximum amount limits and maximum automatic attempt counts before execution.",
        "status": "completed"
      },
      {
        "step_id": "step_4",
        "objective": "Simulate and execute approved automatic recovery actions",
        "rationale": "Running the actions in a simulated environment confirms feasibility, then performing them attempts revenue recovery while staying within policy constraints.",
        "status": "completed"
      },
      {
        "step_id": "step_5",
        "objective": "Observe outcomes of automatic actions and adapt strategy for any failures",
        "rationale": "Monitoring unsuccessful attempts allows the system to apply alternative automatic actions where safe, or to recognize when further automation is inappropriate.",
        "status": "completed"
      },
      {
        "step_id": "step_6",
        "objective": "Escalate payments that cannot be safely recovered automatically to manual_review",
        "rationale": "When policy limits are reached or actions are unsupported, manual review ensures safe handling and compliance with company guidelines.",
        "status": "completed"
      },
      {
        "step_id": "step_7",
        "objective": "Generate a comprehensive, auditable recovery report",
        "rationale": "Documenting retrieved evidence, analysis decisions, policy validations, action outcomes, and escalations provides traceability and satisfies reporting requirements.",
        "status": "completed"
      }
    ]
  },
